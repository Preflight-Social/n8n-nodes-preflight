          "youtubePrivacy": "public",
          "instagramPlacement": "reel",
          "tiktokPrivacy": "SELF_ONLY",
          "tiktokAsDraft": true
        },
        "when": "queue",
        "idempotencyKey": "={{ 'short-' + $('Upload video to Preflight').item.json.id }}"
      },
